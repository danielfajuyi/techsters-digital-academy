# Server port & Public URLs
PORT=5000
APP_URL=http://localhost:5173

# Supabase Server (Service role key bypasses RLS)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth (Handled exclusively on the backend)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Paystack API Keys
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Optional: Transactional Email via Resend
RESEND_API_KEY=
EMAIL_FROM="Techsters Academy <noreply@yourdomain.com>"

# Secret used by the daily reminder job (Vercel Cron sends it automatically). Generate any long random string.
CRON_SECRET=
